<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <TextView
        android:id="@+id/tvmymessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-5dp"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/homep_back"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="15dp"
        android:text="TextView  fjhf\nddsfkjldf\nhuuy\hffdgfgfgfdg\nghhgfhgfhhgfh/n/nnhjjhjhjkjh/n"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/homeProfile"
        app:layout_constraintTop_toBottomOf="@+id/homeProfile" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/homeProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/my_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="122dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="6dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"

        app:layout_constraintEnd_toEndOf="@+id/tvmymessage"
        app:layout_constraintTop_toBottomOf="@+id/tvmymessage">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/homeReplay"
                android:layout_width="120dp"
                android:layout_height="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/homereplay" />

            <TextView
                android:id="@+id/homereplayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="100 replay"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="italic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/homeReplay"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvmymessage"
        app:layout_constraintTop_toBottomOf="@+id/tvmymessage" />

</androidx.constraintlayout.widget.ConstraintLayout>