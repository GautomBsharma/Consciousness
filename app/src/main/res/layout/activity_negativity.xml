<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
    >
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    tools:context=".NegativityActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTrackHaram">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/raund1">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/circleImageView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/drug"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:padding="5dp"
                android:text="Quit Masturbation"
                android:textColor="@color/black"

                app:layout_constraintStart_toEndOf="@+id/circleImageView"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Counting time"
                android:textColor="@color/black"
                app:layout_constraintBottom_toTopOf="@+id/tvShowtimeMaster"
                app:layout_constraintEnd_toEndOf="@+id/progressBarMaster"
                app:layout_constraintStart_toStartOf="@+id/progressBarMaster" />

            <TextView
                android:id="@+id/tvShowtimeMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:text="00 D.00 H.00 M.00 S"
                android:textColor="@color/redBack"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarMaster"
                app:layout_constraintEnd_toEndOf="@+id/progressBarMaster"
                app:layout_constraintStart_toStartOf="@+id/progressBarMaster"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/setMaster"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="-70dp"
                android:src="@drawable/play"

                app:layout_constraintEnd_toEndOf="@+id/progressBarMaster"
                app:layout_constraintTop_toBottomOf="@+id/progressBarMaster" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/resetMaster"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="-50dp"
                android:src="@drawable/round_pause_circle_24"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/progressBarMaster"
                app:layout_constraintTop_toBottomOf="@+id/progressBarMaster" />


            <ProgressBar
                android:id="@+id/progressBarMaster"
                style="@style/CircularDeterminateProgressBar"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:indeterminateOnly="false"
                android:progress="4"
                android:progressDrawable="@drawable/circle"
                android:rotation="90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"


                app:layout_constraintTop_toTopOf="parent"
                tools:progress="4" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="15dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView3">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/breathcolor2">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/circleImageViewp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:src="@drawable/noporn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:padding="5dp"
                android:text="Quit Porn"
                android:textColor="@color/black"

                app:layout_constraintStart_toEndOf="@+id/circleImageViewp"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Counting time"
                android:textColor="@color/black"
                app:layout_constraintBottom_toTopOf="@+id/tvShowtimeporn"
                app:layout_constraintEnd_toEndOf="@+id/progressBarPorn"
                app:layout_constraintStart_toStartOf="@+id/progressBarPorn" />

            <TextView
                android:id="@+id/tvShowtimeporn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:text="00 D.00 H.00 M.00 S"
                android:textColor="@color/redBack"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarPorn"
                app:layout_constraintEnd_toEndOf="@+id/progressBarPorn"
                app:layout_constraintStart_toStartOf="@+id/progressBarPorn"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/setPorn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="-70dp"
                android:src="@drawable/play"

                app:layout_constraintEnd_toEndOf="@+id/progressBarPorn"
                app:layout_constraintTop_toBottomOf="@+id/progressBarPorn" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/resetPorn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="-50dp"
                android:src="@drawable/round_pause_circle_24"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/progressBarPorn"
                app:layout_constraintTop_toBottomOf="@+id/progressBarPorn" />


            <ProgressBar
                android:id="@+id/progressBarPorn"
                style="@style/CircularDeterminateProgressBar"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:indeterminateOnly="false"
                android:progress="4"
                android:progressDrawable="@drawable/circle"
                android:rotation="90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:progress="4" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvTrackHaram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Your Negative Activity"
        android:textColor="@color/redBack"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/goReason"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Reasons"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:gravity="center"
        android:background="@drawable/button_bac"
        android:textColor="@color/white"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView4" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

